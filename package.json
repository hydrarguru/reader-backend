{
  "name": "reader-backend",
  "version": "1.0.0",
  "type": "module",
  "main": ".dist/index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm exec tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:status": "tsx src/db/migrate.ts status",
    "migrate:create": "tsx src/db/migrate.ts create"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
